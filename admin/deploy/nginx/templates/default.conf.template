# Rendered at start-up with ADMIN_* environment values only (NGINX_ENVSUBST_FILTER). The upstream
# host must resolve when nginx starts; in Kubernetes the API Service name does.
map $http_x_forwarded_proto $admin_forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

map $http_x_real_ip $admin_real_ip {
    default $http_x_real_ip;
    "" $remote_addr;
}

server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    absolute_redirect off;
    client_max_body_size 1m;

    # Process health only; it never reaches the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        include /tmp/nginx/security-headers.inc;
        return 200 "ok\n";
    }

    # Same-origin operator API: /api/v1/... -> ${ADMIN_API_UPSTREAM}/v1/... The browser Origin
    # header passes through unchanged so the API can enforce OPERATOR_ALLOWED_ORIGINS and CSRF.
    location ^~ /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${ADMIN_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $admin_real_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $admin_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_redirect off;
        proxy_buffering on;
    }

    # Content-hashed build output: immutable. A missing asset is a 404, never index.html, so a
    # stale document cannot execute HTML as a script.
    location ^~ /assets/ {
        try_files $uri =404;
        include /tmp/nginx/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Build evidence and dotfiles are not served.
    location ~ /\. {
        return 404;
    }

    location = /index.html {
        include /tmp/nginx/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # SPA fallback: existing files are served as-is; every other path renders index.html with 200
    # so TanStack Router owns deep links.
    location / {
        try_files $uri /index.html;
        include /tmp/nginx/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }
}
