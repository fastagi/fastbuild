{
  "name": "fastbuild-desktop",
  "version": "0.1.0",
  "description": "FastBuild desktop client built with Electron, Vite 8, React 19, and Tailwind 4.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json && vite build",
    "clean": "rimraf dist dist-electron coverage .eslintcache *.tsbuildinfo"
  },
  "author": "FastBuild Team",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": "10.34.5"
  },
  "dependencies": {
    "@fastbuild/api-client": "workspace:*",
    "@fastbuild/core": "workspace:*",
    "@fastbuild/tokens": "workspace:*",
    "@fastbuild/ui": "workspace:*",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.5"
}
