{
  "name": "fastbuild-mobile",
  "version": "0.1.0",
  "description": "FastBuild mobile client built with Expo Router, React Native, NativeWind, and shared FastBuild packages.",
  "private": true,
  "main": "expo-router/entry",
  "license": "MIT",
  "author": "FastBuild Team",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "type-check": "tsc --noEmit --pretty false",
    "lint": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastbuild/api-client": "workspace:*",
    "@fastbuild/core": "workspace:*",
    "@fastbuild/tokens": "workspace:*",
    "expo": "~52.0.37",
    "expo-constants": "~17.0.7",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
